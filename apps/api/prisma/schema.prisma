// Schema Prisma – F0 configurazione, F1 sedute, accessi e registro eventi, F2 menù reale, carrello e giri.
// I nomi del dominio seguono il vocabolario del brief (CLAUDE.md §12).
// Importi in centesimi di euro (Int) per evitare errori di arrotondamento.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// I 14 allergeni del Reg. UE 1169/2011 (Allegato II). Allineato a ALLERGENI in @kikko/shared.
enum Allergene {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOY
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum RuoloStaff {
  CAMERIERE
  CAPO
  ADMIN
  MONITOR
}

enum SezioneMenu {
  MENU
  BEVANDE
}

enum StatoGiro {
  INVIATO
  APPROVATO
  RIFIUTATO
}

enum StatoSeduta {
  APERTA
  CHIUSA
}

/// Chi ha compiuto un'azione registrata nel registro eventi.
enum RuoloAttore {
  CLIENTE
  CAMERIERE
  CAPO
  ADMIN
  MONITOR
  SISTEMA
}

/// Tipi di evento (CLAUDE.md §7). Allineato a TIPI_EVENTO in @kikko/shared.
enum TipoEvento {
  TAVOLO_APERTO
  PIN_RIGENERATO
  PIN_ERRATO
  DISPOSITIVO_UNITO
  CARRELLO_MODIFICATO
  GIRO_INVIATO
  GIRO_APPROVATO
  GIRO_RIFIUTATO
  PIATTO_ESAURITO
  PIATTO_RIPRISTINATO
  TEMPO_SCADUTO
  TEMPO_ESTESO
  TAVOLI_UNITI
  TAVOLO_SPOSTATO
  PRECONTO_GENERATO
  TAVOLO_CHIUSO
  CONFIG_MODIFICATA
  CLIENT_RICONNESSO
}

/// Impostazioni globali del locale: una sola riga (id = 1).
model Impostazioni {
  id         Int      @id @default(1)
  nomeLocale String
  fusoOrario String
  valuta     String
  updatedAt  DateTime @updatedAt
}

model Formula {
  id                      String   @id @default(uuid()) @db.Uuid
  codice                  String   @unique
  nomeIt                  String
  nomeEn                  String
  prezzoAdultoCent        Int
  prezzoBambinoCent       Int
  /// Fasce di validità: [{ giorni: number[] (1 = lunedì … 7 = domenica), da: "HH:mm", a: "HH:mm" }]
  fasce                   Json
  piattiPerPersonaPerGiro Int
  minutiTraGiri           Int
  durataMaxMinuti         Int
  maxGiri                 Int?
  attiva                  Boolean  @default(true)
  ordine                  Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Categoria {
  id        String      @id @default(uuid()) @db.Uuid
  codice    String      @unique
  nomeIt    String
  nomeEn    String
  /// MENU: menù della formula; BEVANDE: pagina separata degli extra a pagamento.
  sezione   SezioneMenu @default(MENU)
  ordine    Int         @default(0)
  piatti    Piatto[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

/// Limite condiviso da più piatti ("massimo 4 volte in totale"), per persona.
model GruppoLimite {
  id            String   @id @default(uuid()) @db.Uuid
  codice        String   @unique
  nomeIt        String
  nomeEn        String
  maxPerPersona Int
  piatti        Piatto[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Piatto {
  id                String         @id @default(uuid()) @db.Uuid
  codice            String         @unique
  /// Numero stampato sul menù del locale (es. "8a").
  numero            String?        @unique
  nomeIt            String
  nomeEn            String
  descrizioneIt     String         @default("")
  descrizioneEn     String         @default("")
  categoriaId       String         @db.Uuid
  categoria         Categoria      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  pezzi             Int?
  /// Nome base dei file `{immagine}-480.webp` e `{immagine}-240.webp` in MEDIA_DIR/piatti.
  immagine          String?
  immagineLarghezza Int?
  immagineAltezza   Int?
  /// Anteprima sfocata (data URI) mostrata mentre la foto si carica.
  immagineAnteprima String?
  allergeni         Allergene[]
  vegetariano       Boolean        @default(false)
  piccante          Boolean        @default(false)
  senzaGlutine      Boolean        @default(false)
  inFormula         Boolean        @default(true)
  prezzoExtraCent   Int?
  /// Prezzo alla carta del menù stampato: solo per la dashboard admin, mai inviato ai clienti.
  prezzoCartaCent   Int?
  /// "Massimo N volte" per persona nell'intera seduta (limite = N × coperti).
  maxPerPersona     Int?
  /// Massimo N pezzi in un singolo giro, per tutto il tavolo.
  maxPerGiro        Int?
  gruppoLimiteId    String?        @db.Uuid
  gruppoLimite      GruppoLimite?  @relation(fields: [gruppoLimiteId], references: [id], onDelete: SetNull)
  disponibile       Boolean        @default(true)
  ordine            Int            @default(0)
  vociCarrello      VoceCarrello[]
  vociGiro          VoceGiro[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([categoriaId, ordine])
}

model Tavolo {
  id               String         @id @default(uuid()) @db.Uuid
  numero           Int            @unique
  slugQr           String         @unique
  posti            Int
  /// Posizione nella mappa dei tavoli (unità di griglia).
  posX             Int            @default(0)
  posY             Int            @default(0)
  attivo           Boolean        @default(true)
  /// Seduta aperta in questo momento sul tavolo (al massimo una).
  sedutaCorrenteId String?        @db.Uuid
  sedutaCorrente   Seduta?        @relation("SedutaCorrente", fields: [sedutaCorrenteId], references: [id], onDelete: SetNull)
  sedute           SedutaTavolo[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model UtenteStaff {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  nome         String
  ruolo        RuoloStaff
  passwordHash String
  /// Hash argon2id del PIN personale, usato sui dispositivi condivisi del locale.
  pinHash      String?
  attivo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshToken RefreshToken[]
  seduteAperte Seduta[]       @relation("ApertaDa")
  seduteChiuse Seduta[]       @relation("ChiusaDa")
}

/// Dispositivo del locale (tablet cassa, telefono di servizio) su cui lo staff entra con il PIN personale.
model DispositivoStaff {
  id            String         @id @default(uuid()) @db.Uuid
  nome          String
  /// SHA-256 del token di dispositivo (cookie httpOnly di lunga durata).
  tokenHash     String         @unique
  registratoDa  String         @db.Uuid
  creatoIl      DateTime       @default(now())
  ultimoAccesso DateTime       @default(now())
  revocatoIl    DateTime?
  refreshToken  RefreshToken[]
}

/// Refresh token dello staff, ruotato a ogni uso. Un riuso di un token già ruotato revoca l'intera famiglia.
model RefreshToken {
  id                 String            @id @default(uuid()) @db.Uuid
  /// SHA-256 del token: il valore in chiaro esiste solo nel cookie.
  tokenHash          String            @unique
  famiglia           String            @db.Uuid
  utenteId           String            @db.Uuid
  utente             UtenteStaff       @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  dispositivoStaffId String?           @db.Uuid
  dispositivoStaff   DispositivoStaff? @relation(fields: [dispositivoStaffId], references: [id], onDelete: Cascade)
  creatoIl           DateTime          @default(now())
  scadeIl            DateTime
  usatoIl            DateTime?
  revocatoIl         DateTime?

  @@index([famiglia])
}

/// Apertura di uno o più tavoli: dal momento in cui il cameriere apre al conto.
model Seduta {
  id              String               @id @default(uuid()) @db.Uuid
  stato           StatoSeduta          @default(APERTA)
  formulaId       String               @db.Uuid
  /// Copia della formula al momento dell'apertura (CLAUDE.md §4): le modifiche successive non la toccano.
  formulaSnapshot Json
  copertiAdulti   Int
  copertiBambini  Int
  /// HMAC-SHA256 del PIN con il segreto del server.
  pinHash         String
  pinGeneratoIl   DateTime             @default(now())
  apertaIl        DateTime             @default(now())
  apertaDaId      String               @db.Uuid
  apertaDa        UtenteStaff          @relation("ApertaDa", fields: [apertaDaId], references: [id])
  chiusaIl        DateTime?
  chiusaDaId      String?              @db.Uuid
  chiusaDa        UtenteStaff?         @relation("ChiusaDa", fields: [chiusaDaId], references: [id])
  minutiExtra     Int                  @default(0)
  tavoli          SedutaTavolo[]
  tavoliCorrenti  Tavolo[]             @relation("SedutaCorrente")
  dispositivi     DispositivoCliente[]
  carrello        VoceCarrello[]
  giri            Giro[]

  @@index([stato])
}

/// Tavoli occupati da una seduta (più di uno quando i tavoli vengono uniti, F3).
model SedutaTavolo {
  sedutaId String    @db.Uuid
  seduta   Seduta    @relation(fields: [sedutaId], references: [id], onDelete: Cascade)
  tavoloId String    @db.Uuid
  tavolo   Tavolo    @relation(fields: [tavoloId], references: [id])
  dalIl    DateTime  @default(now())
  alIl     DateTime?

  @@id([sedutaId, tavoloId])
  @@index([tavoloId])
}

/// Smartphone di un cliente entrato con il PIN.
model DispositivoCliente {
  id            String         @id @default(uuid()) @db.Uuid
  sedutaId      String         @db.Uuid
  seduta        Seduta         @relation(fields: [sedutaId], references: [id], onDelete: Cascade)
  /// SHA-256 del token di dispositivo (cookie httpOnly).
  tokenHash     String         @unique
  soprannome    String
  emoji         String
  creatoIl      DateTime       @default(now())
  ultimoAccesso DateTime       @default(now())
  revocatoIl    DateTime?
  vociCarrello  VoceCarrello[]
  giriInviati   Giro[]

  @@index([sedutaId])
}

/// Carrello condiviso del tavolo: una riga per piatto per dispositivo (ognuno modifica solo le proprie).
model VoceCarrello {
  id            String             @id @default(uuid()) @db.Uuid
  sedutaId      String             @db.Uuid
  seduta        Seduta             @relation(fields: [sedutaId], references: [id], onDelete: Cascade)
  piattoId      String             @db.Uuid
  piatto        Piatto             @relation(fields: [piattoId], references: [id], onDelete: Cascade)
  dispositivoId String             @db.Uuid
  dispositivo   DispositivoCliente @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  quantita      Int
  aggiornatoIl  DateTime           @updatedAt

  @@unique([sedutaId, piattoId, dispositivoId])
}

/// Ordinazione inviata dal tavolo, da approvare alla cassa (F4).
model Giro {
  id                String              @id @default(uuid()) @db.Uuid
  sedutaId          String              @db.Uuid
  seduta            Seduta              @relation(fields: [sedutaId], references: [id], onDelete: Cascade)
  numero            Int
  stato             StatoGiro           @default(INVIATO)
  /// Generata dal dispositivo a ogni invio: ripetere la richiesta non crea un secondo giro.
  chiaveIdempotenza String
  /// Solo extra (bevande): non conta per il timer né per il numero di giri.
  soloExtra         Boolean             @default(false)
  inviatoIl         DateTime            @default(now())
  inviatoDaId       String?             @db.Uuid
  inviatoDa         DispositivoCliente? @relation(fields: [inviatoDaId], references: [id], onDelete: SetNull)
  gestitoDaId       String?             @db.Uuid
  gestitoIl         DateTime?
  motivoRifiuto     String?
  voci              VoceGiro[]

  @@unique([sedutaId, chiaveIdempotenza])
  @@unique([sedutaId, numero])
  @@index([stato, inviatoIl])
}

model VoceGiro {
  id              String  @id @default(uuid()) @db.Uuid
  giroId          String  @db.Uuid
  giro            Giro    @relation(fields: [giroId], references: [id], onDelete: Cascade)
  piattoId        String  @db.Uuid
  piatto          Piatto  @relation(fields: [piattoId], references: [id], onDelete: Restrict)
  quantita        Int
  /// Copie al momento dell'invio, per il pre-conto (F4).
  inFormula       Boolean
  prezzoExtraCent Int?

  @@index([giroId])
}

/// Contatore anti-forza bruta per una chiave (dispositivo/IP, tavolo, PIN staff).
model TentativoPin {
  chiave       String    @id
  falliti      Int       @default(0)
  blocchi      Int       @default(0)
  bloccatoFino DateTime?
  aggiornatoIl DateTime  @updatedAt
}

/// Registro eventi (CLAUDE.md §7). `seq` è progressivo e segue l'ordine di commit.
model Evento {
  seq                BigInt      @id @default(autoincrement())
  ts                 DateTime    @default(now())
  tipo               TipoEvento
  attoreRuolo        RuoloAttore
  attoreId           String?     @db.Uuid
  dispositivoStaffId String?     @db.Uuid
  sedutaId           String?     @db.Uuid
  tavoloId           String?     @db.Uuid
  payload            Json        @default("{}")

  @@index([sedutaId, seq])
  @@index([tipo, seq])
}
