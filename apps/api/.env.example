# Copia in apps/api/.env e adatta. Fuori da produzione tutte le variabili hanno un default.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Postgres di docker-compose.yml
DATABASE_URL=postgresql://kikko:kikko@localhost:5432/kikko
# Database usato dai test di integrazione (creato e migrato in automatico)
TEST_DATABASE_URL=postgresql://kikko:kikko@localhost:5432/kikko_test
# Admin creato da `npm run db:seed` (obbligatoria in produzione)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# --- F1: accessi e sicurezza ---
# Segreti (obbligatori in produzione, almeno 32 caratteri). Genera con: openssl rand -base64 48
# JWT_SECRET=
# PIN_HMAC_SECRET=
# Durate delle sessioni staff
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90
SHARED_DEVICE_SESSION_TTL_HOURS=14
# Cookie con flag Secure (default: true in produzione)
# COOKIE_SECURE=false
# Dietro un proxy (Caddy): numero di proxy fidati per leggere l'IP reale
# TRUST_PROXY=1
# Limiti di richieste al minuto per IP
THROTTLE_PUBLIC_LIMIT=20
THROTTLE_DEFAULT_LIMIT=300
